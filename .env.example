# Do not put a real key in this file or commit one to Git.
# The browser key must be restricted to seismic.balog.jp and Maps JavaScript API.
GOOGLE_MAPS_BROWSER_API_KEY=

# Local Docker environment only. Change these if the database is exposed or shared.
CSN_HTTP_PORT=8080
DB_PASSWORD=csn-local-only
DB_ROOT_PASSWORD=csn-root-local-only
