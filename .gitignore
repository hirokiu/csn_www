# ignore everything in the root except the "wp-content" directory.
!wp-content/

# ignore everything in the "wp-content" directory, except:
# "mu-plugins", "plugins", "themes" directory
wp-content/*
!wp-content/mu-plugins/
!wp-content/plugins/
!wp-content/themes/

# ignore these plugins
wp-content/plugins/hello.php

# ignore specific themes
wp-content/themes/twenty*/

# ignore node dependency directories
node_modules/
.env
.env.*
!.env.example

# ignore log files and databases
*.log
*.sql
!docker/db/init/*.sql
*.sqlite

# ignore author page
author/

# ignore data dir
data
data/
htdocs/data/

# WIDOCO WebVOWL needs these generated JSON files in production.
!htdocs/ontology/docs/webvowl/data/
!htdocs/ontology/docs/webvowl/data/*.json

# WIDOCO may leave temporary files while regenerating documentation.
htdocs/ontology/docs.tmp/
